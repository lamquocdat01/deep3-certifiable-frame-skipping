# ============================================================================
# cfs-mcu default sdkconfig — ESP32-S3 CAM WROOM-1 N16R8
# 16 MB flash (QIO) + 8 MB Octal (OPI) PSRAM.
#
# PSRAM=Octal is the classic N16R8 failure point: with Quad selected the camera
# driver cannot allocate frame buffers and esp32-camera init fails. See README.
# ============================================================================

CONFIG_IDF_TARGET="esp32s3"

# ---- Flash: 16 MB, QIO ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- PSRAM: 8 MB Octal (OPI) @ 80 MHz ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- CPU @ 240 MHz ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ---- Custom partition table (larger app for TFLM + camera) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Console on UART0 (CH343 USB-serial), 115200 ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ---- Optimise for size/speed; TFLM likes -O2 ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- Larger main task stack: TFLM interpreter + camera in app_main path ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ---- 1 ms FreeRTOS tick so the 30 fps loop pacing has fine resolution ----
CONFIG_FREERTOS_HZ=1000

# ---- Keep default log level modest so STATS lines stay parseable ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- C2b: INA219 power sensor wired on GPIO1/GPIO2 (enabled 2026-07-30) ----
# Camera SCCB is a separate bus on GPIO4/5 (GOOUUU pin map), so GPIO1/2 are free.
#
# 2026-07-31 (step A attempt 3, module #2 wire-wrap): POWER PINS showed pu=1,pd=1
# on BOTH GPIO1 and GPIO2 — the module's pull-ups are visible, so VCC and both
# signal joints conduct. Yet 0x40 does not ACK and a full 0x08..0x77 scan finds
# nothing. The transposed-SDA/SCL hypothesis was tested in firmware (SDA=2,
# SCL=1, built + flashed + probed) and ALSO found nothing, so the mapping is
# not the fault. Reverted to the user's label-read wiring below.
# NOTE: visible pull-ups do NOT prove GND is connected — the module's pull-ups
# sit between VCC and SDA/SCL, so an open GND joint yields exactly this
# signature (lines held high, chip unpowered internally, no ACK either way).
CONFIG_CFS_HAS_INA219=y
CONFIG_CFS_INA219_SDA_GPIO=1
CONFIG_CFS_INA219_SCL_GPIO=2
CONFIG_CFS_INA219_ADDR=0x40
